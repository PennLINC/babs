#!/bin/bash
set -e -u -x

subid="$1"
{% if processing_level == 'session' %}
sesid="$2"
{% endif %}
{% for input_ds in input_datasets|selectattr('is_zipped') %}
{{ input_ds['name'] | shell_safe }}_ZIP="${{ loop.index + (2 if processing_level == 'session' else 1) }}"
{% endfor %}

{% if flag_filterfile %}
# Create a filter file that only allows this session
filterfile="${PWD}/${sesid}_filter.json"
{% raw %}{{% endraw %}
    echo "{"
    {# The fmap entry must NOT carry 'session'. fmriprep passes this entry to sdcflows'
       find_estimators() together with the session it resolved itself, and sdcflows rejects
       receiving the session twice. The session is already enforced by the sparse checkout. #}
    echo "'fmap': {'datatype': 'fmap'},"
{% if 'fmriprep' in container_name.lower() %}
    echo "'bold': {'datatype': 'func', 'session': '$sesid', 'suffix': 'bold'},"
{% elif 'qsiprep' in container_name.lower() %}
    echo "'dwi': {'datatype': 'dwi', 'session': '$sesid', 'suffix': 'dwi'},"
{% elif 'aslprep' in container_name.lower() %}
    echo "'asl': {'datatype': 'perf', 'session': '$sesid', 'suffix': 'asl'},"
{% endif %}
    echo "'sbref': {'datatype': 'func', 'session': '$sesid', 'suffix': 'sbref'},"
    echo "'flair': {'datatype': 'anat', 'session': '$sesid', 'suffix': 'FLAIR'},"
    echo "'t2w': {'datatype': 'anat', 'session': '$sesid', 'suffix': 'T2w'},"
    echo "'t1w': {'datatype': 'anat', 'session': '$sesid', 'suffix': 'T1w'},"
    echo "'roi': {'datatype': 'anat', 'session': '$sesid', 'suffix': 'roi'}"
    echo "}"
{% raw %}}{% endraw %} > "${filterfile}"

# remove ses and get valid json
sed -i "s/'/\"/g" "${filterfile}"
sed -i "s/ses-//g" "${filterfile}"

{% endif %}
{% if cmd_unzip_inputds %}
{{ cmd_unzip_inputds }}
{% endif %}
mkdir -p "${PWD}/.git/tmp/wkdir"
{% if templateflow_home_on_disk %}
mkdir -p {{ templateflow_home_on_disk }}
{% endif %}

mkdir -p "{{ bids_app_output_dir }}"
# duct (con-duct) records the app's resource usage and stdout/stderr in the
# project's analysis/logs/duct/, outside this job's clone, so they can be read
# while the job runs and survive a failed one. Keyed by start time and SLURM job
# id. duct is used only if the script_preamble put it on PATH (activating the
# babs env does); otherwise the app runs without it.
runner=""
if command -v duct >/dev/null 2>&1; then
    runner="duct"
    duct_dir="${BABS_ANALYSIS_DIR}/logs/duct/${subid}{% if processing_level == 'session' %}/${sesid}{% endif %}"
    duct_job="${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
    export DUCT_OUTPUT_PREFIX="${duct_dir}/acq-{datetime}+${duct_job}_"
else
    echo "WARNING: duct not on PATH, running without resource records; activate the babs env in script_preamble to record them" >&2
fi
${runner} singularity run \
    -B "${PWD}" \
{% if templateflow_home_on_disk %}
    -B "{{ templateflow_home_on_disk }}":"{{ templateflow_in_container }}" \
    --env "TEMPLATEFLOW_HOME={{ templateflow_in_container }}" \
{% endif %}
{% if flag_fs_license %}
    -B "{{ path_fs_license }}":"{{ PATH_FS_LICENSE_IN_CONTAINER }}" \
{% endif %}
{% for singularity_flag in singularity_flags %}
    {{ singularity_flag }} \
{% endfor %}
    "{{ container_path_relToAnalysis }}" \
        "${PWD}/{{ bids_app_input_dir }}" \
        "${PWD}/{{ bids_app_output_dir }}" \
        participant \
{% if flag_filterfile %}
        --bids-filter-file "${filterfile}" \
{% endif %}
{% for bids_app_arg in bids_app_args %}
{% if bids_app_arg %}
        {{ bids_app_arg }} \
{% endif %}
{% endfor %}
        {{ subject_selection_flag }} "${subid}"

if [ -n "${runner}" ]; then
    # The app succeeded: copy this job's duct records next to its output so they
    # are zipped with the results. A failed copy is reported, not fatal, so it
    # cannot cost the job its results.
    duct_zip_dir="{{ bids_app_output_dir }}/logs/${subid}{% if processing_level == 'session' %}/${sesid}{% endif %}"
    mkdir -p "${duct_zip_dir}"
    cp "${duct_dir}"/*+"${duct_job}"_* "${duct_zip_dir}/" \
        || echo "WARNING: duct records not copied into the results; they stay in ${duct_dir}" >&2
fi

{{ cmd_zip }}
rm -rf {{ OUTPUT_MAIN_FOLDERNAME }} .git/tmp/wkdir
{% if flag_filterfile %}
rm -f "${filterfile}"
{% endif %}